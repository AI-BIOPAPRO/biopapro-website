# ─── Sanity CMS (blog + /studio) ───
# From your Sanity project settings. Without these, blog routes and the sitemap
# fall back gracefully but no posts are shown.
NEXT_PUBLIC_SANITY_PROJECT_ID="9h45iw4q"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2024-01-01"

# ─── Contact / export-inquiry form (app/api/contact) ───
# Delivery uses Resend's REST API. Leave RESEND_API_KEY unset and the form
# falls back to opening the visitor's email client (mailto:).
RESEND_API_KEY=""
CONTACT_TO_EMAIL="export@biopapro.com"
# Must be a domain verified in Resend, e.g. "Biopapro Website <website@biopapro.com>"
CONTACT_FROM_EMAIL=""

# ─── Legacy (Google AI Studio) — unused by the Next.js app ───
# GEMINI_API_KEY=""
# APP_URL=""
