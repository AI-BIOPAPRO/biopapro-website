# ─── Contact / export-inquiry form (app/api/contact) ───
# Delivery uses Resend's REST API. Leave RESEND_API_KEY unset and the form
# falls back to opening the visitor's email client (mailto:).
RESEND_API_KEY=""
CONTACT_TO_EMAIL="export@biopapro.com"
# Must be a domain verified in Resend, e.g. "Biopapro Website <website@biopapro.com>"
CONTACT_FROM_EMAIL=""
